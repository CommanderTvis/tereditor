<StackPanel xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:kit="using:Tereditor.Plugins.UI.Kit"
            x:Class="Tereditor.Plugins.Runtimes.UI.RuntimesSettingsView" x:ClassModifier="internal"
            Name="SettingsRuntimes" Spacing="16">
  <StackPanel.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{x:Static kit:Ui.TextBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="TextTrimming" Value="None" />
    </Style>
    <Style Selector="TextBlock.detail">
      <Setter Property="Foreground" Value="{x:Static kit:Ui.Muted}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </StackPanel.Styles>
  <StackPanel Spacing="4">
    <TextBlock Text="Runtimes for tooling" FontSize="15" FontWeight="SemiBold" />
    <TextBlock Classes="detail" Text="Language servers and agents need Bun and uv to run packages. tereditor uses your own install when there is one. If there is none, it downloads its own copy the first time a plugin asks, never at startup. Turning this plugin off stops everything that runs from its downloads and deletes them. Your paths below are kept." />
  </StackPanel>
  <StackPanel x:Name="RuntimesProgress" Spacing="6" />
  <StackPanel x:Name="RuntimesRows" Spacing="20" />
  <TextBlock x:Name="RuntimesError" Classes="detail" IsVisible="False" />
</StackPanel>

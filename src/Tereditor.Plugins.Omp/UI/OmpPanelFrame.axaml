<DockPanel xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:kit="using:Tereditor.Plugins.UI.Kit"
           x:Class="Tereditor.Plugins.Omp.UI.OmpPanelFrame" x:ClassModifier="internal">
  <DockPanel.Styles>
    <Style Selector="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </DockPanel.Styles>
  <TextBlock x:Name="OmpError" DockPanel.Dock="Top" Margin="8,4" IsVisible="False" FontSize="13" Foreground="{x:Static kit:Ui.Danger}" />
  <Panel>
    <ScrollViewer x:Name="OmpContextTab" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="8,4" Spacing="8">
        <TextBlock Text="Context files" FontSize="13" Foreground="{x:Static kit:Ui.Muted}" />
        <StackPanel x:Name="OmpContextRows" Spacing="2" />
        <WrapPanel x:Name="OmpOffers" Orientation="Horizontal" />
      </StackPanel>
    </ScrollViewer>
    <StackPanel x:Name="OmpSettingsTab" Margin="8,4" Spacing="4" IsVisible="False">
      <StackPanel x:Name="OmpNotes" Spacing="4">
        <TextBlock x:Name="OmpCodeIntelligence" FontSize="12" Foreground="{x:Static kit:Ui.Muted}" />
        <TextBlock x:Name="OmpProfileNote" FontSize="12" Foreground="{x:Static kit:Ui.Muted}" />
      </StackPanel>
      <TextBlock x:Name="OmpSettingsNothing" FontSize="12" Foreground="{x:Static kit:Ui.Hint}"
                 Text="omp has no other settings here. Change them in Settings, omp." />
    </StackPanel>
    <StackPanel x:Name="OmpCapabilitiesTab" Margin="8,4" IsVisible="False">
      <TextBlock x:Name="OmpCapabilitiesNothing" FontSize="12" Foreground="{x:Static kit:Ui.Hint}" Text="omp has nothing here yet." />
    </StackPanel>
    <StackPanel x:Name="OmpAccountTab" Margin="8,4" Spacing="4" IsVisible="False">
      <ContentControl x:Name="OmpProviderHost" HorizontalContentAlignment="Stretch" />
      <TextBlock x:Name="OmpVersion" FontSize="12" Foreground="{x:Static kit:Ui.Hint}" />
      <StackPanel x:Name="OmpMissing" Spacing="4" IsVisible="False">
        <TextBlock x:Name="OmpMissingText" FontSize="13" Foreground="{x:Static kit:Ui.Danger}" />
        <TextBlock x:Name="OmpMissingNote" FontSize="12" Foreground="{x:Static kit:Ui.Muted}" Text="tereditor uses the omp on your PATH and does not install it." />
        <ContentControl x:Name="OmpInstallLink" />
      </StackPanel>
      <StackPanel x:Name="OmpSignIn" Spacing="4" IsVisible="False">
        <Button x:Name="OmpImportSignIn" HorizontalAlignment="Left" Content="Use my omp sign-in in tereditor"
                ToolTip.Tip="Runs omp auth export into omp --profile tereditor auth import on the host; tereditor never stores the credentials."
                AutomationProperties.Name="Use my omp sign-in in tereditor" />
        <TextBlock x:Name="OmpSignInResult" FontSize="12" Foreground="{x:Static kit:Ui.Muted}" IsVisible="False" />
      </StackPanel>
      <TextBlock x:Name="OmpAccountNothing" FontSize="12" Foreground="{x:Static kit:Ui.Hint}" IsVisible="False"
                 Text="omp keeps its own sign-in. Turn on MCP in Settings, omp to copy it." />
    </StackPanel>
  </Panel>
</DockPanel>

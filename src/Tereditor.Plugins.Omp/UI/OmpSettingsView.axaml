<StackPanel xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:agent="using:Tereditor.Plugins.Agent.UI"
            x:Class="Tereditor.Plugins.Omp.UI.OmpSettingsView" x:ClassModifier="internal"
            Name="SettingsOmp" Spacing="16">
  <StackPanel Spacing="4">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Text="omp" FontSize="15" FontWeight="SemiBold" />
      <agent:EarlySupportBadge />
    </StackPanel>
    <TextBlock Classes="detail" Text="Launch flags for omp sessions tereditor starts. omp runs from a pinned copy that tereditor downloads and runs on Bun, or from your system installation (https://omp.sh)." />
  </StackPanel>
  <StackPanel x:Name="ModelSourceHost" />
  <agent:AgentSourceSection x:Name="SourceSection" />
  <StackPanel Spacing="4">
    <TextBlock Text="Model (--model)" />
    <AutoCompleteBox x:Name="OmpModel" PlaceholderText="Use omp's default" MinimumPrefixLength="0" FilterMode="Contains" AutomationProperties.Name="omp model" />
    <TextBlock Classes="detail" Text="A model id, provider/model, or a role such as @smol. Suggestions come from omp's docs; any value is accepted." />
  </StackPanel>
  <StackPanel Spacing="4">
    <TextBlock Text="Approval mode (--approval-mode)" />
    <AutoCompleteBox x:Name="OmpApprovalMode" PlaceholderText="Use omp's configuration" MinimumPrefixLength="0" FilterMode="Contains" AutomationProperties.Name="omp approval mode" />
    <TextBlock Classes="detail" Text="always-ask, always-ask-cached, write or yolo; any value is passed through." />
  </StackPanel>
  <CheckBox x:Name="OmpAdvisor" AutomationProperties.Name="Run with the advisor">
    <StackPanel Spacing="2">
      <TextBlock Text="Run with the advisor (--advisor)" />
      <TextBlock Classes="detail" Text="Passive per-turn review with injected advice." />
    </StackPanel>
  </CheckBox>
  <CheckBox x:Name="OmpMcp" AutomationProperties.Name="Give sessions tereditor's tools">
    <StackPanel Spacing="2">
      <TextBlock Text="Give sessions tereditor's tools" />
      <TextBlock Classes="detail" Text="Launches with the tereditor omp profile, whose mcp.json tereditor owns. The profile has its own sign-in, settings and sessions; the omp side tool can copy your default omp sign-in into it." />
    </StackPanel>
  </CheckBox>
  <CheckBox x:Name="OmpOwnLsp" AutomationProperties.Name="Use omp's own code intelligence">
    <StackPanel Spacing="2">
      <TextBlock Text="Use omp's own code intelligence" />
      <TextBlock Classes="detail" Text="Off: sessions start with --no-lsp and use tereditor's shared language servers through the lsp_* tools." />
    </StackPanel>
  </CheckBox>
</StackPanel>

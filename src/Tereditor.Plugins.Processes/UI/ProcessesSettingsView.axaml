<StackPanel xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:kit="using:Tereditor.Plugins.UI.Kit"
            x:Class="Tereditor.Plugins.Processes.UI.ProcessesSettingsView" x:ClassModifier="internal"
            Name="SettingsProcesses" Spacing="16">
  <StackPanel.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{x:Static kit:Ui.TextBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="TextTrimming" Value="None" />
    </Style>
    <Style Selector="TextBlock.detail">
      <Setter Property="Foreground" Value="{x:Static kit:Ui.Muted}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </StackPanel.Styles>
  <StackPanel Spacing="4">
    <TextBlock Text="Processes" FontSize="15" FontWeight="SemiBold" />
  </StackPanel>
  <CheckBox x:Name="ProcessesStopAgentChildren" AutomationProperties.Name="Stop what an agent started along with it">
    <StackPanel Spacing="2">
      <TextBlock Text="Stop what an agent started along with it" />
      <TextBlock Classes="detail" Text="Stopping an agent's row also stops every process it started. Off stops only the agent's own process; stop a child by selecting its row." />
    </StackPanel>
  </CheckBox>
  <StackPanel Spacing="4">
    <TextBlock Text="Memory guard" FontSize="15" FontWeight="SemiBold" />
    <TextBlock Classes="detail" Text="tereditor's own out-of-memory killer for programs started in terminals. It samples every terminal's processes every few seconds and warns at 80% of a limit. Above it, tereditor asks the largest process to stop, kills it after a grace period and, if the terminal is still over, everything below the shell. The shell and the terminal stay, with a notice. It also steps in when the system is nearly out of memory for several samples in a row. It samples, so a program that allocates faster than that can overshoot. Shared by every client of this host. Turning off the Processes plugin turns the guard off too." />
  </StackPanel>
  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
    <TextBlock Text="Stop programs that use too much memory" VerticalAlignment="Center" />
    <kit:Switch x:Name="ProcessesMemoryGuard" Grid.Column="1" Label="Stop programs that use too much memory" VerticalAlignment="Center" />
  </Grid>
  <StackPanel x:Name="ProcessesMemoryLimits" Spacing="16">
    <StackPanel Spacing="4">
      <TextBlock Text="Limit per terminal" />
      <ComboBox x:Name="ProcessesMemoryPerTerminal" HorizontalAlignment="Stretch" AutomationProperties.Name="Memory limit per terminal" />
    </StackPanel>
    <StackPanel Spacing="4">
      <TextBlock Text="Limit for all terminals together" />
      <ComboBox x:Name="ProcessesMemoryTotal" HorizontalAlignment="Stretch" AutomationProperties.Name="Memory limit for all terminals together" />
    </StackPanel>
    <StackPanel Spacing="4">
      <TextBlock Text="Protected processes" />
      <TextBlock Classes="detail" Text="Names separated by commas. The guard only warns about them. Build tools are protected already: dotnet, csc, VBCSCompiler, MSBuild, cl, link, ld, clang, rustc, cargo, go, javac, kotlinc, gradle and java below gradle. They are stopped only when they run away: over twice the limit, or over it for 15 minutes. Names here add to that list." />
      <TextBox x:Name="ProcessesMemoryProtect" PlaceholderText="for example postgres, my-database" AutomationProperties.Name="Programs the memory guard never stops" />
    </StackPanel>
  </StackPanel>
</StackPanel>

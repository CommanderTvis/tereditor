<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:kit="using:Tereditor.Plugins.UI.Kit"
        x:Class="Tereditor.UI.Panels.LicenseActivationWindow"
        Width="520" MinWidth="360" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" WindowDecorations="None" ShowInTaskbar="False"
        Background="{x:Static kit:Ui.Elevated}" Foreground="{x:Static kit:Ui.TextBrush}"
        FontFamily="{x:Static kit:Ui.InterfaceFont}" FontSize="14">
  <Border Padding="24" BorderThickness="1" BorderBrush="{x:Static kit:Ui.BorderBrush}">
    <StackPanel Spacing="8">
      <TextBlock x:Name="ActivationHeading" Text="Activate your license" FontSize="18" FontWeight="SemiBold" />
      <TextBlock x:Name="ActivationHelp" TextWrapping="Wrap" Foreground="{x:Static kit:Ui.Muted}" />
      <ComboBox x:Name="ActivationKind" HorizontalAlignment="Stretch" SelectedIndex="0" AutomationProperties.Name="How to activate">
        <ComboBoxItem Content="Activation code" />
        <ComboBoxItem Content="License file or zip" />
        <ComboBoxItem Content="License server" />
      </ComboBox>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBox x:Name="ActivationInput" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" AutomationProperties.Name="Activation input" />
        <Button x:Name="ActivationBrowse" Grid.Column="1" Content="Browse…" VerticalAlignment="Top" IsVisible="False" />
      </Grid>
      <ProgressBar x:Name="ActivationProgress" IsIndeterminate="True" IsVisible="False" />
      <TextBlock x:Name="ActivationError" TextWrapping="Wrap" Foreground="{x:Static kit:Ui.Danger}" IsVisible="False" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button x:Name="ActivationSubmit" Content="Activate" />
        <Button x:Name="ActivationCancel" Content="Cancel" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>

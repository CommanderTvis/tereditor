<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Tereditor.UI.Panels.AboutFields">
  <StackPanel Spacing="12">
    <StackPanel Orientation="Horizontal" Spacing="12">
      <Grid VerticalAlignment="Center">
        <Button x:Name="AboutFrog" Padding="0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="tereditor logo">
          <ContentControl x:Name="AboutBrand" />
        </Button>
        <Popup x:Name="AboutSpeech" PlacementTarget="{Binding #AboutFrog}" Placement="Right" IsLightDismissEnabled="True">
          <Grid Margin="0,0,8,8">
            <Border x:Name="AboutSpeechTail" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Center" RenderTransform="rotate(45deg)" BorderThickness="1,0,0,1" />
            <Border x:Name="AboutSpeechBubble" Margin="4,0,0,0" Padding="8,4" CornerRadius="4" BorderThickness="1">
              <TextBlock Text="tero-tero!" FontSize="12" />
            </Border>
          </Grid>
        </Popup>
      </Grid>
      <StackPanel VerticalAlignment="Center">
        <SelectableTextBlock x:Name="AboutName" FontSize="18" FontWeight="SemiBold" />
        <SelectableTextBlock x:Name="AboutVersion" FontSize="12" />
      </StackPanel>
    </StackPanel>
    <SelectableTextBlock x:Name="AboutDescription" TextWrapping="Wrap" />
    <SelectableTextBlock x:Name="AboutRuntime" FontSize="12" TextWrapping="Wrap" />
    <SelectableTextBlock x:Name="AboutLicense" FontSize="12" TextWrapping="Wrap" />
    <WrapPanel Orientation="Horizontal">
      <Button x:Name="AboutRepository" Padding="0,0,16,0" Background="Transparent" BorderThickness="0" />
      <Button x:Name="AboutUpstream" Padding="0,0,16,0" Background="Transparent" BorderThickness="0" />
      <Button x:Name="AboutIssue" Padding="0" Background="Transparent" BorderThickness="0" />
    </WrapPanel>
    <WrapPanel x:Name="AboutActions" Orientation="Horizontal" />
  </StackPanel>
</UserControl>

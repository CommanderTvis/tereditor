<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kit="using:Tereditor.Plugins.UI.Kit"
             x:Class="Tereditor.Plugins.AirGateway.UI.AirSettingsView"
             x:ClassModifier="internal">
  <UserControl.Styles>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>
  <StackPanel Spacing="16">
    <TextBlock Text="Air Gateway" FontSize="14" FontWeight="SemiBold" Foreground="{x:Static kit:Ui.TextBrush}" />
    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{x:Static kit:Ui.Muted}"
               Text="JetBrains AI (Central) is one choice of the Model source setting, the first setting on the Claude Code, Codex and Pi pages. Choose it there for an agent to take its AI from JetBrains AI through the Central CLI.&#10;&#10;The choice only changes the command that starts each new agent terminal or chat. No agent configuration file is edited. It applies to terminals and chats you start afterwards; sessions already running keep their old command.&#10;&#10;tereditor checks Central's sign-in status on its own when this page opens, when the window regains focus, and while a sign-in is waiting. Everything else (signing in or out, switching source, starting the proxy, updating Central) runs only when you press its button. The AI access sources below are listed automatically while Central governs an agent." />
    <TextBlock x:Name="AirCentralLine" TextWrapping="Wrap" Text="Checking Central…" />
    <TextBlock x:Name="AirCredits" TextWrapping="Wrap" IsVisible="False" Foreground="{x:Static kit:Ui.TextBrush}" />
    <StackPanel x:Name="AirInstall" Spacing="4" IsVisible="False">
      <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{x:Static kit:Ui.Muted}" Text="Install the JetBrains Central CLI (central) yourself, then recheck:" />
      <TextBox x:Name="AirInstallCommand" IsReadOnly="True" FontFamily="{x:Static kit:Ui.CodeFont}" />
    </StackPanel>
    <WrapPanel Orientation="Horizontal">
      <Button x:Name="AirSignIn" Content="Sign in" Margin="0,0,8,8" />
      <Button x:Name="AirSignOut" Content="Sign out" Margin="0,0,8,8" />
      <Button x:Name="AirStartProxy" Content="Start proxy" Margin="0,0,8,8" IsVisible="False" />
      <Button x:Name="AirUpdate" Content="Update Central" Margin="0,0,8,8" IsVisible="False" />
    </WrapPanel>
    <StackPanel Spacing="6">
      <TextBlock Text="What new launches will run" Foreground="{x:Static kit:Ui.TextBrush}" />
      <TextBlock x:Name="AirLaunches" TextWrapping="Wrap" FontFamily="{x:Static kit:Ui.CodeFont}" Foreground="{x:Static kit:Ui.TextBrush}" />
      <TextBlock x:Name="AirLaunchNote" TextWrapping="Wrap" FontSize="12" Foreground="{x:Static kit:Ui.Muted}" />
      <TextBlock x:Name="AirResult" TextWrapping="Wrap" FontSize="12" Foreground="{x:Static kit:Ui.Muted}" />
    </StackPanel>
    <StackPanel Spacing="6">
      <TextBlock Text="JetBrains AI access source" Foreground="{x:Static kit:Ui.TextBrush}" />
      <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{x:Static kit:Ui.Muted}" Text="Which organization, workspace or licence Central bills. The sources are listed automatically with your signed-in Central session; switching restarts its proxy." />
      <TextBlock x:Name="AirAccessScope" TextWrapping="Wrap" FontSize="12" Foreground="{x:Static kit:Ui.Muted}" Text="Switching changes the source for every app that uses this computer user's Central, not only tereditor." />
      <StackPanel x:Name="AirAccessSources" Spacing="4" />
      <TextBlock x:Name="AirAccessNote" TextWrapping="Wrap" FontSize="12" Foreground="{x:Static kit:Ui.Muted}" />
    </StackPanel>
  </StackPanel>
</UserControl>

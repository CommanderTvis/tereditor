<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rendering="using:Tereditor.Plugins.UI.Kit"
             xmlns:local="using:Tereditor.Plugins.CodeIntelligence.UI"
             x:Class="Tereditor.Plugins.CodeIntelligence.UI.CodeIntelligencePage" x:ClassModifier="internal"
             Name="LspPage">
  <UserControl.Resources>
    <local:ServerMarkConverter x:Key="LanguageMark" />
  </UserControl.Resources>
<StackPanel Spacing="8">
  <TextBlock Text="Language servers" Classes="settings-heading" />
  <TextBlock Text="Shared by all workspaces and clients of this host. Per-server changes apply on the next Start / Retry." Classes="settings-description" />
  <TextBlock x:Name="LspLifetimeNote" Classes="settings-description" />
  <CheckBox x:Name="LspFeatureEnabled" Content="Enable LSP" />
  <TextBlock Text="Turning this off stops all language servers and disables editor and agent language features. Saved server configurations are kept." Classes="settings-description" />
  <ContentControl x:Name="ProviderChoiceSettings" Margin="0,8" />
  <Grid ColumnDefinitions="128,*" Margin="0,8,0,8">
    <Border BorderBrush="{x:Static rendering:Ui.BorderBrush}" BorderThickness="0,0,1,0" Padding="0,0,8,0">
      <ListBox x:Name="LspServer" Background="Transparent" BorderThickness="0" VerticalAlignment="Top" AutoScrollToSelectedItem="False"
               ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               AutomationProperties.Name="Language server settings">
        <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="MinHeight" Value="0" /><Setter Property="Padding" Value="8,4" /></Style></ListBox.Styles>
        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="local:CodeIntelligencePage+LspServerItem">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ContentControl Name="SettingsLanguageIcon" Content="{Binding Id, Converter={StaticResource LanguageMark}}" />
              <TextBlock Text="{Binding Id}" VerticalAlignment="Center" />
              <Ellipse Name="LspMissingMarker" IsVisible="{Binding Missing}" Width="6" Height="6" Fill="{x:Static rendering:Ui.Danger}" VerticalAlignment="Center"
                       ToolTip.Tip="A tool this server needs is missing" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
    <StackPanel Grid.Column="1" Spacing="8" Margin="16,0,0,0">
      <TextBlock x:Name="LspServerHeading" Classes="settings-heading verbatim" />
      <rendering:LinkedTextBlock x:Name="LspImplementation" TextWrapping="Wrap" />
      <TextBlock x:Name="LspVersion" Classes="settings-description" />
      <StackPanel x:Name="LspTermsSection" Spacing="4" IsVisible="False">
        <TextBlock Text="License terms" Classes="settings-label" />
        <TextBlock x:Name="LspTermsStatus" TextWrapping="Wrap" Classes="settings-description" />
        <WrapPanel>
          <Button x:Name="LspReviewTerms" Content="Review and accept terms" Margin="0,0,8,0" />
          <Button x:Name="LspInstall" Content="Install now" Margin="0,0,8,0" IsVisible="False" />
          <Button x:Name="LspInstallRetry" Content="Retry" IsVisible="False" />
        </WrapPanel>
        <TextBlock x:Name="LspInstallStatus" TextWrapping="Wrap" />
      </StackPanel>
      <WrapPanel x:Name="LspProviderLinks" IsVisible="False">
        <Button x:Name="LspProviderWebsite" Content="Website ↗" Classes="link" Margin="0,0,16,0" />
        <Button x:Name="LspProviderRepository" Content="Source repository ↗" Classes="link" />
      </WrapPanel>
      <CheckBox x:Name="LspAllowPath" Content="Use the executable on PATH instead of the managed installation" />
      <TextBlock x:Name="LspResolved" TextWrapping="Wrap" Classes="settings-description" />
      <TextBlock x:Name="LspPathWarning" TextWrapping="Wrap" IsVisible="False" Classes="settings-description" />
      <StackPanel x:Name="LspDependencySection" Spacing="4" IsVisible="False">
        <TextBlock Text="System dependencies" Classes="settings-label" />
        <local:LanguageDependencyList x:Name="LspDependencies" />
        <TextBlock Text="Host tools this server needs. A path you choose is outside the workspace and used by every language server on this host." Classes="settings-description" />
      </StackPanel>
      <TextBlock Text="The managed copy is checked before it runs. A program from PATH is used only if you allow it, and never from inside the workspace. Project files cannot choose programs." Classes="settings-description" />
      <TextBlock Text="Executable override" Classes="settings-label" />
      <TextBox x:Name="LspCommand" PlaceholderText="Automatic" />
      <CheckBox x:Name="LspDefaultArguments" Content="Use default arguments" />
      <TextBlock Text="Executable override arguments (one per line)" Classes="settings-label" />
      <TextBox x:Name="LspArguments" AcceptsReturn="True" MinHeight="80" TextWrapping="Wrap" />
      <TextBlock Text="Set an executable override to customize its arguments. With default arguments turned off, an empty list passes no arguments. An executable override takes precedence over the managed installation. Saving replaces any file-based override for this server." Classes="settings-description" />
      <Button x:Name="LspSave" Content="Save server settings" HorizontalAlignment="Left" />
      <TextBlock x:Name="LspMessage" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
  <TextBlock Text="Host storage" Classes="settings-label" Margin="0,16,0,0" />
  <TextBlock x:Name="LspStorage" Classes="settings-description" />
  <TextBlock Text="Installations and supported caches are reused across workspaces. Use the Code Intelligence pane to start, stop or retry servers. Diagnostic scans never install servers." Classes="settings-description" />
</StackPanel>
</UserControl>
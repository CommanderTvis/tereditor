<Border xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:kit="using:Tereditor.Plugins.UI.Kit" x:Class="Tereditor.Plugins.Agent.UI.EarlySupportBadge"
        Background="{x:Static kit:Ui.WarningWash}" CornerRadius="4" Padding="4,0" HorizontalAlignment="Left" VerticalAlignment="Center">
  <TextBlock Text="Early support" FontSize="10" Foreground="{x:Static kit:Ui.Warning}" />
</Border>

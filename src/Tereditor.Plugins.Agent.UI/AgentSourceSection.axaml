<StackPanel xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:kit="using:Tereditor.Plugins.UI.Kit" x:Class="Tereditor.Plugins.Agent.UI.AgentSourceSection" Spacing="16">
  <StackPanel Spacing="4">
    <TextBlock x:Name="SourceTitle" />
    <kit:OptionCards x:Name="Source" />
    <TextBlock x:Name="SourceNote" Classes="detail" Foreground="{x:Static kit:Ui.Warning}" IsVisible="False" />
  </StackPanel>
  <StackPanel x:Name="ManagedPanel" Spacing="8" IsVisible="False">
    <TextBlock x:Name="ManagedLine" />
    <TextBlock x:Name="ManagedError" Classes="detail" Foreground="{x:Static kit:Ui.Danger}" IsVisible="False" />
    <StackPanel x:Name="ManagedProgress" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button x:Name="ManagedDownload" Content="Download" />
      <Button x:Name="ManagedRemove" Content="Remove download" />
    </StackPanel>
  </StackPanel>
  <StackPanel x:Name="CommandPanel" Spacing="4">
    <TextBlock x:Name="CommandTitle" />
    <TextBox x:Name="CommandInput" FontFamily="{x:Static kit:Ui.CodeFont}" FontSize="12" />
  </StackPanel>
</StackPanel>

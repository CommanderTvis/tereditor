<Project>
  <!--
    The desktop app and the remote host publish as NativeAOT in every package, and headless tereditor in its image; they are the
    projects that import this file, and nothing else is NativeAOT (src/Tereditor.Plugins.Api/Security.SPEC.md, NativeAOT section). Packages carry neither the native symbol files nor the
    PDB, XML and runtimeconfig.json files of referenced projects a publish would otherwise copy beside the binary.
  -->
  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>
  <!--
    Linux strips the binary at link, so no objcopy step runs. The C compiler and linker are the platform's clang; CI builds
    the Linux packages on Ubuntu 22.04, so the binary needs no glibc newer than 2.35.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64' or '$(RuntimeIdentifier)' == 'linux-arm64'">
    <StripSymbols>false</StripSymbols>
    <CompressSymbols>false</CompressSymbols>
  </PropertyGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64' or '$(RuntimeIdentifier)' == 'linux-arm64'">
    <ExtraLinkerArg Include="--strip-all" />
  </ItemGroup>
  <Target Name="TereditorAotPublishNativeOnly" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(PublishAot)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb' or $([System.String]::Copy('%(Filename)%(Extension)').EndsWith('.runtimeconfig.json'))" />
    </ItemGroup>
  </Target>
</Project>
